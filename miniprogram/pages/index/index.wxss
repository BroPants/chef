/* ══════════════════════════════════
   设计 Token
   ══════════════════════════════════ */
/* 主背景：#fafaf8  卡片：#fff  分割线：#e8e5e0
   品牌绿深：#2d5a27  品牌绿浅填充：#e8f0e5  品牌绿文字：#3a6b34
   正文主：#111  次：#888  提示：#aaa                       */

/* ── 自定义导航栏 ── */
.nav-bar {
  background: #fafaf8;
  width: 100%;
  box-sizing: border-box;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-logo {
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: #1a1a1a;
}

.nav-more {
  font-size: 20rpx;
  color: #aaaaaa;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ── 主内容区 ── */
.body {
  padding: 64rpx 32rpx 60rpx;
  background: #fafaf8;
  min-height: calc(100vh - 44px);
  box-sizing: border-box;
}

/* ── 功能标签 Pill ── */
.pill {
  display: inline-block;
  background: #e8f0e5;
  color: #3a6b34;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  margin-bottom: 36rpx;
}

/* ── 主标题 ── */
.title-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.3;
}

/* ── 副标题 ── */
.subtitle-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 56rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #888888;
  line-height: 1.6;
}

/* ── 操作入口卡片 ── */
.action-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #e0ddd8;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 28rpx;
}

.action-row--hover {
  background: #f5f2ed;
}

/* 图标容器 */
.icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-dark {
  background: #2d5a27;
}

.icon-warm {
  background: #f0ede8;
}

.icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* 文字区 */
.action-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.action-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #111111;
  line-height: 1.4;
}

.action-desc {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.4;
}

.action-arrow {
  font-size: 40rpx;
  color: #cccccc;
  line-height: 1;
  margin-left: auto;
}

/* 行间分割线（左对齐到文字，不穿透图标） */
.row-divider {
  height: 1rpx;
  background: #e8e5e0;
  margin: 0 28rpx 0 116rpx;
}

/* ── 加载状态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin: 60rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e8e8e8;
  border-top-color: #2d5a27;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #aaaaaa;
}

/* ── 错误提示 ── */
.error-wrap {
  padding: 32rpx;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #cf1322;
  margin-bottom: 12rpx;
}

.error-tip {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.error-actions {
  display: flex;
  justify-content: center;
}

.btn-retry {
  padding: 14rpx 48rpx;
  font-size: 26rpx;
  color: #2d5a27;
  background: #fff;
  border: 1rpx solid #2d5a27;
  border-radius: 8rpx;
}

/* ── 最近识别 ── */
.recent-section {
  margin-top: 8rpx;
}

.recent-label {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  color: #aaaaaa;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  background: #f0ede8;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.chip--hover {
  background: #e5e2dd;
}

.chip-text {
  font-size: 20rpx;
  color: #555555;
}
