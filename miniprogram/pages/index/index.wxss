/* ── 自定义导航栏 ── */
.nav-bar {
  background: #fafaf8;
  width: 100%;
  box-sizing: border-box;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-logo {
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: #1a1a1a;
}

.nav-more {
  font-size: 20rpx;
  color: #aaaaaa;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ── 主内容区 ── */
.body {
  padding: 64rpx 32rpx 60rpx;
  background: #fafaf8;
  min-height: calc(100vh - 44px);
  box-sizing: border-box;
}

/* ── Pill ── */
.pill {
  display: inline-block;
  background: #e8f0e5;
  color: #3a6b34;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 6rpx 20rpx;
  border-radius: 40rpx;
  margin-bottom: 36rpx;
}

/* ── 主标题 ── */
.title-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.3;
}

/* ── 副标题 ── */
.subtitle-block {
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #888888;
  line-height: 1.6;
}

/* ── 操作入口卡片 ── */
.action-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #e0ddd8;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.action-row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  gap: 24rpx;
}

.action-row--hover {
  background: #f5f2ed;
}

.icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-dark { background: #2d5a27; }
.icon-warm { background: #f0ede8; }

.icon-img {
  width: 32rpx;
  height: 32rpx;
}

.action-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.action-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #111111;
  line-height: 1.4;
}

.action-desc {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.4;
}

.action-arrow {
  font-size: 40rpx;
  color: #cccccc;
  line-height: 1;
}

.row-divider {
  height: 1rpx;
  background: #f2f2f2;
  margin: 0 28rpx 0 116rpx;
}

/* ── 食材找菜入口 ── */
.suggest-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #e0ddd8;
  padding: 26rpx 28rpx;
  margin-bottom: 32rpx;
}

.suggest-entry--hover {
  background: #f5f2ed;
}

.suggest-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f0ede8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.suggest-icon {
  font-size: 32rpx;
}

.suggest-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.suggest-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #111111;
}

.suggest-desc {
  font-size: 20rpx;
  color: #999999;
}

/* ── 加载状态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin: 60rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #e8e8e8;
  border-top-color: #2d5a27;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #aaaaaa;
}

/* ── 错误提示 ── */
.error-wrap {
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #cf1322;
  margin-bottom: 12rpx;
}

.error-tip {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.error-actions { display: flex; justify-content: center; }

.btn-retry {
  padding: 14rpx 48rpx;
  font-size: 26rpx;
  color: #2d5a27;
  background: #fff;
  border: 1rpx solid #2d5a27;
  border-radius: 8rpx;
}

/* ── 通用区块标签 ── */
.section-label {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  color: #aaaaaa;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

/* ── 每日推荐 ── */
.rec-section {
  margin-bottom: 32rpx;
}

.rec-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e8e5e0;
  overflow: hidden;
}

.rec-card--hover {
  opacity: 0.92;
}

.rec-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #f0ede8;
}

.rec-info {
  padding: 24rpx 28rpx 28rpx;
}

.rec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.rec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.refresh-btn {
  padding: 6rpx 16rpx;
  background: #f0ede8;
  border-radius: 20rpx;
}

.refresh-text {
  font-size: 20rpx;
  color: #888888;
}

.rec-desc {
  font-size: 22rpx;
  color: #888888;
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.rec-tags {
  display: flex;
  gap: 12rpx;
}

.rec-tag {
  background: #f5f3f0;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}

.rec-tag-text {
  font-size: 20rpx;
  color: #666666;
}

/* 骨架屏 */
.rec-skeleton {}

.rec-img-skeleton {
  width: 100%;
  height: 320rpx;
  background: #f0ede8;
  animation: shimmer 1.2s ease-in-out infinite;
}

.rec-info-skeleton {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  background: #f0ede8;
  border-radius: 8rpx;
  animation: shimmer 1.2s ease-in-out infinite;
}

.w60 { width: 60%; }
.w40 { width: 40%; }

@keyframes shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ── 最近识别 ── */
.recent-section { margin-top: 8rpx; }

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  background: #f0ede8;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.chip--hover { background: #e5e2dd; }

.chip-text {
  font-size: 20rpx;
  color: #555555;
}
