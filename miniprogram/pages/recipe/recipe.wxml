<view class="container">

  <!-- 菜品名 -->
  <view class="header" wx:if="{{dishName}}">
    <text class="dish-name">{{dishName}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误 -->
  <view class="error" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 食材列表 -->
  <view class="section" wx:if="{{baseIngredients.length > 0}}">
    <view class="section-header">
      <text class="section-title">所需食材</text>
      <view class="servings-control">
        <view class="servings-btn {{servings <= 1 ? 'disabled' : ''}}" bindtap="changeServings" data-delta="{{-1}}">−</view>
        <text class="servings-text">{{servings}}人份</text>
        <view class="servings-btn {{servings >= 10 ? 'disabled' : ''}}" bindtap="changeServings" data-delta="{{1}}">+</view>
      </view>
    </view>
    <view class="ingredient-list">
      <view class="ingredient-item" wx:for="{{scaledIngredients}}" wx:key="*this">
        <text class="ingredient-dot">•</text>
        <text class="ingredient-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 制作步骤 -->
  <view class="section" wx:if="{{steps.length > 0}}">
    <text class="section-title">制作步骤</text>
    <view class="step-list">
      <view class="step-item" wx:for="{{steps}}" wx:for-item="step" wx:key="*this">
        <view class="step-num">{{index + 1}}</view>
        <text class="step-text">{{step}}</text>
      </view>
    </view>
  </view>

  <!-- 相关教程 -->
  <view class="section" wx:if="{{!loading && (externalContent.bilibili.length > 0 || externalContent.xiaohongshu.length > 0)}}">
    <text class="section-title">相关教程</text>
    <text class="section-hint">点击卡片复制链接，在浏览器中打开</text>

    <!-- B站 -->
    <view
      class="content-card"
      wx:for="{{externalContent.bilibili}}"
      wx:key="index"
      bindtap="onExternalTap"
      data-url="{{item.url}}"
      hover-class="content-card--hover"
      hover-stay-time="100"
    >
      <view class="platform-badge platform-bili">B站</view>
      <view class="content-info">
        <text class="content-title">{{item.title}}</text>
        <text class="content-author">{{item.author}}</text>
      </view>
      <text class="content-arrow">›</text>
    </view>

    <!-- 小红书 -->
    <view
      class="content-card"
      wx:for="{{externalContent.xiaohongshu}}"
      wx:key="index"
      bindtap="onExternalTap"
      data-url="{{item.url}}"
      hover-class="content-card--hover"
      hover-stay-time="100"
    >
      <view class="platform-badge platform-xhs">小红书</view>
      <view class="content-info">
        <text class="content-title">{{item.title}}</text>
        <text class="content-author">{{item.author}}</text>
      </view>
      <text class="content-arrow">›</text>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!loading && !dishName && !error}}">
    <text class="empty-text">暂无菜谱数据</text>
  </view>

</view>
